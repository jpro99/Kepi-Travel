# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets); keep .env.example tracked for onboarding
.env*
!.env.example
!.env.test

# playwright — regenerated by global.setup.ts before every e2e run; contains a signed session token
storageState.json

# agent worktrees — temporary, per-session parallel work dirs, never commit
.claude/worktrees/

# service worker build output — next-pwa injectManifest writes sw.js in place
# over its own source (see next.config.js) and emits a matching sourcemap;
# public/sw.js itself stays tracked as the hand-authored source, restore it
# with `git checkout -- public/sw.js` after a local build.
public/sw.js.map

# generated by postinstall (MapLibre CSP worker copy)
/public/maplibre-gl-csp-worker.js

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/
.gstack/

# Android Studio project-local state (machine-specific: connected device
# history, workspace layout, caches) — never shared between machines.
android/.idea/
